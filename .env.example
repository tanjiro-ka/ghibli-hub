# =============================================================================
# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains secrets)
# =============================================================================

# PostgreSQL Database
# You can override these; docker-compose.yml uses the same defaults
POSTGRES_USER=ghibli_user
POSTGRES_PASSWORD=ghibli_password
POSTGRES_DB=ghibli_db

# Full database URL used by the app (keep in sync if you change the values above)
DATABASE_URL=postgresql://ghibli_user:ghibli_password@db:5432/ghibli_db

# GitHub OAuth 2.0
# Get these values from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OAuth Redirect URI
# Must match the redirect URI configured in your GitHub OAuth app
# For local development:
GITHUB_OAUTH_REDIRECT=http://localhost:8000/auth/github/callback

# JWT Secret Key
# IMPORTANT: Generate a secure random key for production!
# Use one of these methods:
#   Option 1 (recommended): python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Option 2: openssl rand -hex 32
#   Option 3: https://randomkeygen.com/ (use "256-bit WPA Key" or "CodeIgniter Encryption Keys")
# For development only, you can use a simple string (but NEVER in production!)
SECRET_KEY=dev-secret-key-please-change-in-production-12345

# JWT Token Lifetimes (in seconds)
# Access tokens: shorter lived (default 7 days = 604800 seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=604800

# Refresh tokens: longer lived (default 30 days = 2592000 seconds)
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# Application Settings
# FastAPI host and port (Docker: 0.0.0.0, Local: 127.0.0.1)
APP_HOST=0.0.0.0
APP_PORT=8000

# Environment mode (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# Notes for Development
# =============================================================================
# 1. To get GitHub OAuth credentials:
#    - Go to https://github.com/settings/developers
#    - Click "New OAuth App"
#    - Fill in:
#      * Application name: My Ghibli World (or your app name)
#      * Homepage URL: http://localhost:8000
#      * Authorization callback URL: http://localhost:8000/auth/github/callback
#    - Copy Client ID and Client Secret to this file

# 2. SECRET_KEY generation (IMPORTANT for production):
#    Generate a secure random key using Python (recommended method):
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
#    
#    Alternative methods:
#      - OpenSSL: openssl rand -hex 32
#      - Online generator: https://randomkeygen.com/ (use "256-bit WPA Key")
#    
#    Requirements:
#      - At least 32 characters long
#      - Randomly generated (never use predictable values)
#      - Unique per environment (dev, staging, prod should have different keys)
#      - NEVER commit to version control

# 3. Token lifetimes:
#    - Access tokens: shorter for security (minutes to hours in production)
#    - Refresh tokens: longer to minimize re-authentication (days)
#    - Current defaults (7 days / 30 days) are for development only
#    - For production, consider: access=1h, refresh=7d

# 4. DATABASE_URL format for different databases:
#    - PostgreSQL: postgresql://user:password@host:port/dbname
#    - MySQL: mysql+pymysql://user:password@host:port/dbname
#    - SQLite (local dev only): sqlite:///./test.db
